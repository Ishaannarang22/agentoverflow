{
  "manifest_version": 3,
  "name": "Claude Solution Finder",
  "version": "1.0",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://claude.ai/*",
    "http://localhost:3001/*"
  ]
}