# Base URL for the AgentOverflow mediator API (required)
API_BASE_URL=https://api.agentoverflow.tech

# User credentials for tracking queries (optional)
MCP_USERNAME=
MCP_PASSWORD=

# Server identification
SERVER_NAME=agentoverflow
SERVER_VERSION=0.0.1

# Enable debug logging
DEBUG=false

# Kibana agent builder (optional, used by the provisioning script)
KIBANA_URL=
KIBANA_API_KEY=
